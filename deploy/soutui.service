[Unit]
Description=Soutui ecommerce service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/soutui
Environment=PYTHONPATH=/home/ubuntu/soutui/src
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/soutui.env
ExecStart=/usr/bin/python3 -m uvicorn soutui.api:app --host 127.0.0.1 --port 8088 --root-path /shop --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/soutui/data

[Install]
WantedBy=multi-user.target
