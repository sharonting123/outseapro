facefun.store, www.facefun.store {
	encode zstd gzip

	request_body {
		max_size 12MB
	}

	@shop_exact path /shop
	redir @shop_exact https://soutui-api-986118955496.us-east1.run.app/ 308

	handle_path /shop/* {
		redir https://soutui-api-986118955496.us-east1.run.app{uri} 308
	}

	@apk_download path /download /download/
	handle @apk_download {
		root * /var/www/facefun
		rewrite * /FaceShift.apk
		header Content-Type application/vnd.android.package-archive
		header Content-Disposition "attachment; filename=FaceShift.apk"
		header Cache-Control "no-store"
		file_server
	}

	@landing path / /index.html
	handle @landing {
		root * /var/www/facefun
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:8000
	}
}

