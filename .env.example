# Stripe Checkout (required for real charges)
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_endpoint_secret

# Set to 1 only when the public site is served through HTTPS.
SOUTUI_SECURE_COOKIE=1
SOUTUI_BASE_PATH=/shop

# Used once to create the first merchant, then remove the password from env.
SOUTUI_BOOTSTRAP_MERCHANT_EMAIL=merchant@example.com
SOUTUI_BOOTSTRAP_MERCHANT_PASSWORD=replace-with-a-strong-password
SOUTUI_BOOTSTRAP_MERCHANT_NAME=平台商家
